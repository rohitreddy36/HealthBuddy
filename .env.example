# Copy this file to .env (or .env.local) and fill in real values.
# Get Supabase values from your Supabase project settings (or Lovable Cloud,
# if this project is connected there): Project Settings -> API.
# Get a Gemini key from https://aistudio.google.com/apikey

# --- Supabase (required) ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=

# Anon/publishable key — safe to expose to the browser, used by src/integrations/supabase/client.ts
# and as a fallback in the auth middleware.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Service role key — server-only, bypasses Row Level Security.
# Used by src/integrations/supabase/client.server.ts (supabaseAdmin). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (required) ---
# Used by src/lib/health.functions.ts and src/routes/api/chat.ts for AI-generated
# symptom guidance, document analysis, and chat.
GEMINI_API_KEY=
# Optional model override. Keep AI credentials server-only (no VITE_ prefix).
GEMINI_MODEL=gemini-3.8-flash
# Faster Gemini fallback used by both chat interfaces, separate from report analysis.
CHAT_GEMINI_MODEL=gemini-3.1-flash-lite

# --- Groq (preferred chatbot provider, Gemini is the fallback) ---
# Get a key from https://console.groq.com/keys
# Both chat interfaces try Groq first, then Gemini on errors/timeouts.
# Configure at least one provider in Vercel Production environment variables.
# Symptom/report analysis still uses Gemini.
# Server-only, never prefixed with VITE_.
GROQ_API_KEY=
# Optional model override; use a model available to your Groq account.
GROQ_MODEL=openai/gpt-oss-120b

# --- Clerk (required) ---
# Get these from your Clerk Dashboard -> API Keys (https://dashboard.clerk.com).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Email reminders (Gmail SMTP) ---
# SMTP_USER: the Gmail address to send from.
# SMTP_PASS: a Gmail App Password (NOT your normal password) -- requires
#   2-Step Verification on the Google account. Create one at
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AIL Health

# Bearer token the daily reminder cron must send as
# "Authorization: Bearer <this>" to POST /api/reminders/daily.
# Generate any long random string, e.g. `openssl rand -hex 32`.
REMINDER_CRON_SECRET=

# --- Hospital discovery (optional -- Feature A: Smart Hospital Recommendation) ---
# Get a key from https://serpapi.com (free tier has a limited monthly quota;
# results are cached -- see HOSPITAL_CACHE_TTL_MINUTES). Server-only, never
# exposed to the browser. Without this, hospital search returns an empty
# list with a clear "not configured" message instead of breaking.
SERPAPI_API_KEY=

# Minutes to cache a hospital search result for a given rounded
# location+radius+specialty before re-querying SerpApi. Default: 360 (6h).
HOSPITAL_CACHE_TTL_MINUTES=360
