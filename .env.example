# Copy this file to .env (or .env.local) and fill in real values.
# Get Supabase values from your Supabase project settings (or Lovable Cloud,
# if this project is connected there): Project Settings -> API.
# Get a Gemini key from https://aistudio.google.com/apikey

# --- Supabase (required) ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
VITE_SUPABASE_URL=

# Anon/publishable key — safe to expose to the browser, used by src/integrations/supabase/client.ts
# and as a fallback in the auth middleware.
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Service role key — server-only, bypasses Row Level Security.
# Used by src/integrations/supabase/client.server.ts (supabaseAdmin). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (required) ---
# Used by src/lib/health.functions.ts and src/routes/api/chat.ts for AI-generated
# symptom guidance, document analysis, and chat.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# --- Clerk (required) ---
# Get these from your Clerk Dashboard -> API Keys (https://dashboard.clerk.com).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Email reminders (Gmail SMTP) ---
# SMTP_USER: the Gmail address to send from.
# SMTP_PASS: a Gmail App Password (NOT your normal password) -- requires
#   2-Step Verification on the Google account. Create one at
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AIL Health

# Bearer token the daily reminder cron must send as
# "Authorization: Bearer <this>" to POST /api/reminders/daily.
# Generate any long random string, e.g. `openssl rand -hex 32`.
REMINDER_CRON_SECRET=
